{
  "name": "eks-fargate-scaler",
  "private": true,
  "scripts": {
    "build": "esbuild scripts/fargate_off.ts --bundle --platform=node --target=node22 --format=cjs --outfile=dist/fargate_off.js",
    "typecheck": "tsc --noEmit --strict --skipLibCheck --target es2022 --module commonjs --moduleResolution node scripts/fargate_off.ts tests/fargate_off.test.ts",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-eks": "^3.900.0",
    "@aws-sdk/credential-provider-node": "^3.900.0",
    "@smithy/protocol-http": "^5.6.2",
    "@smithy/signature-v4": "^5.7.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
