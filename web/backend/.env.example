YOUTUBE_API_KEY=your_api_key_here
# Provide a MongoDB URI with the intended database name. Never commit the real URI.
# For local development, omit this line to use backend/src/config/db.json instead.
ACCESS_MONGODB_URI=mongodb://localhost:27017/youtube_trends
# Required for API keys and SMTP passwords saved from the Settings UI. Keep stable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY_ENCRYPTION_KEY=replace_with_a_random_32_byte_secret
PORT=8080

# Optional SMTP fallback settings; these can also be configured in the Settings UI.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@example.com

# CORS
CORS_ORIGIN=http://localhost:5173
