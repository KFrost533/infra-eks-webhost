{
  "name": "youtube-web-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --config frontend/vite.config.ts frontend",
    "build": "tsc -b && vite build --config frontend/vite.config.ts frontend",
    "preview": "vite preview frontend --config frontend/vite.config.ts",
    "backend:dev": "tsx backend/src/server.ts",
    "backend:start": "node --import tsx backend/src/server.ts",
    "backend:typecheck": "tsc -p backend/tsconfig.json --noEmit",
    "backend:test": "node --import tsx --test backend/test/*.test.ts"
  },
  "dependencies": {
    "mongoose": "^8.19.1",
    "dotenv": "^18.0.5",
    "express": "^5.2.1",
    "i18next": "^23.15.2",
    "nodemailer": "^10.0.14",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.3",
    "react-router-dom": "^6.27.0",
    "recharts": "^2.13.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "tsx": "^4.23.15",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
